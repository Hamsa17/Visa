        <script><![CDATA[(function allDocsVerifiedWorknote(current, previous) {
    var caseId = current.getValue('u_case');
    if (!caseId) {
        return;
    }

    // Check for any remaining un-verified documents
    var unverified = new GlideRecord('x_2023506_german_1_case_doc');
    unverified.addQuery('u_case', caseId);
    unverified.addQuery('u_status', '!=', 'verified');
    unverified.query();

    // If no un-verified docs remain, post work note on parent case
    if (!unverified.hasNext()) {
        var caseRecord = new GlideRecord('x_2023506_german_1_imm_case');
        if (caseRecord.get(caseId)) {
            caseRecord.work_notes = 'All required immigration documents have been verified by the caseworker.';
            caseRecord.update();
        }
    }
})(current, previous);
]]></script>
