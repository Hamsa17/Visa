        <script><![CDATA[(function validateDocCompletion(current, previous) {
    var docs = new GlideRecord('x_2023506_german_1_case_doc');
    docs.addQuery('u_case', current.getUniqueValue());
    docs.addQuery('u_status', '!=', 'verified');
    docs.query();

    if (docs.hasNext()) {
        gs.addErrorMessage("Cannot close case: All mandatory documents (Passport, Degree, Vollmacht, Contract) must be marked as 'Verified' before proceeding.");
        current.setAbortAction(true);
    }
})(current, previous);
]]></script>
