    <name>Simulate Day 30 Check-In (Demo)</name>
    <onclick/>
    <order>100</order>
    <script><![CDATA[(function() {
    var checkin = new GlideRecord('x_2023506_german_1_ret_chkin');
    checkin.addQuery('u_retention_case', current.getUniqueValue());
    checkin.addQuery('u_milestone', '30_days');
    checkin.setLimit(1);
    checkin.query();

    if (checkin.next()) {
        checkin.setValue('u_status', 'sent');
        var today = new GlideDateTime();
        checkin.setValue('u_due_date', today.getLocalDate().toString());
        checkin.update();
        gs.addInfoMessage('Day 30 check-in activated. Survey invitation is now available.');
    } else {
        gs.addWarningMessage('No Day 30 check-in record found for this Retention Case.');
    }

    action.setRedirectURL(current);
})();]]></script>
